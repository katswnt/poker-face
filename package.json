    "audit:multiway-side-pot-river": "node --import tsx scripts/solve-multiway-side-pot-river.ts --check",
    "audit:multiway-four-player-river": "node --import tsx scripts/solve-multiway-four-player-river.ts --check",
    "bench": "node --import tsx bench/equity-bench.ts",
    "bench:trainer": "node --import tsx bench/trainer-equity-accuracy.ts",
    "generate:solver": "node --import tsx scripts/gen-pushfold-solutions.mjs",
    "solve:kuhn": "node --import tsx scripts/solve-kuhn.ts",
    "solve:leduc": "node --import tsx scripts/solve-leduc.ts",
    "solve:turn": "node --import tsx scripts/solve-heads-up-turn.ts",
    "solve:river": "node --import tsx scripts/solve-river.ts",
    "solve:river:v2": "node --import tsx scripts/solve-configurable-river.ts",
