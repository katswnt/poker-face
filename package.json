{
  "name": "poker-face",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:e2e": "playwright test",
    "audit:math": "node --import tsx scripts/audit-math.ts",
    "audit:kuhn": "node --import tsx scripts/solve-kuhn.ts --check",
    "audit:leduc": "node --import tsx scripts/solve-leduc.ts --check",
    "audit:river": "node --import tsx scripts/solve-river.ts --check",
    "audit:multiway-river": "node --import tsx scripts/solve-multiway-river.ts --check",
    "bench": "node --import tsx bench/equity-bench.ts",
    "generate:solver": "node --import tsx scripts/gen-pushfold-solutions.mjs",
    "solve:kuhn": "node --import tsx scripts/solve-kuhn.ts",
    "solve:leduc": "node --import tsx scripts/solve-leduc.ts",
    "solve:river": "node --import tsx scripts/solve-river.ts",
    "solve:multiway-river": "node --import tsx scripts/solve-multiway-river.ts",
    "solve:toy": "npm run solve:kuhn && npm run solve:leduc"
  },
  "dependencies": {
    "next": "16.3.3",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "fast-check": "^4.9.0",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
