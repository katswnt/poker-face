    "audit:river": "node --import tsx scripts/solve-river.ts --check",
    "audit:river:v2": "node --import tsx scripts/solve-configurable-river.ts --check",
    "audit:river:compact": "node --import tsx scripts/audit-compact-river.ts",
    "audit:river:scorekeeper": "node --import tsx scripts/audit-compact-scorekeeper.ts",
    "audit:river:factorized": "node --import tsx scripts/audit-factorized-river.ts",
    "audit:river:v3": "node --import tsx scripts/solve-configurable-river-v3.ts --check",
    "solver:river": "node --import tsx scripts/river-exchange.ts",
    "audit:river:exchange": "node --import tsx scripts/audit-river-exchange.ts --check",
    "generate:river:benchmarks": "node --import tsx scripts/audit-river-exchange.ts --write",
    "profile:river:factorized": "node --import tsx scripts/profile-factorized-boundary.ts",
