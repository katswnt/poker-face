    "solve:multiway-river": "node --import tsx scripts/solve-multiway-river.ts",
    "solve:multiway-raised-river": "node --import tsx scripts/solve-multiway-raised-river.ts",
    "solve:multiway-two-size-river": "node --import tsx scripts/solve-multiway-two-size-river.ts",
    "solve:multiway-side-pot-river": "node --import tsx scripts/solve-multiway-side-pot-river.ts",
    "solve:multiway-four-player-river": "node --import tsx scripts/solve-multiway-four-player-river.ts",
    "solve:toy": "npm run solve:kuhn && npm run solve:leduc"
