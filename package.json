{
  "name": "poker-face",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:e2e": "playwright test",
    "audit:math": "node --import tsx scripts/audit-math.ts",
    "audit:kuhn": "node --import tsx scripts/solve-kuhn.ts --check",
    "audit:leduc": "node --import tsx scripts/solve-leduc.ts --check",
